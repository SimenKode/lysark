{
  "name": "lysark",
  "version": "0.2.0",
  "description": "Turns PPTX lectures into interactive HTML and video with voice-over in USN's visual identity",
  "private": true,
  "license": "GPL-3.0-or-later",
  "main": "./out/main/index.js",
  "scripts": {
    "build:player": "vite build --config vite.player.config.ts",
    "dev": "npm run build:player && electron-vite dev",
    "build": "npm run build:player && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && vitest run",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\"",
    "fetch:ffmpeg": "node tools/fetch-ffmpeg.mjs",
    "licenses": "node tools/collect-licenses.mjs",
    "dist:linux": "npm run fetch:ffmpeg -- linux-x64 && npm run licenses && npm run build && electron-builder --linux",
    "dist:win": "npm run fetch:ffmpeg -- win32-x64 && npm run licenses && npm run build && electron-builder --win zip",
    "test:unit": "vitest run tests/shared.test.ts tests/more.test.ts tests/sound.test.ts tests/commons.test.ts tests/importer.test.ts tests/importer-html.test.ts tests/importer-pdf.test.ts tests/projectIo.test.ts",
    "dist:win-installer": "npm run fetch:ffmpeg -- win32-x64 && npm run licenses && npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "fast-xml-parser": "^5.12.1",
    "fflate": "^0.8.3",
    "immer": "^11.2.10",
    "pdfjs-dist": "^6.5.438",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-history": "^1.5.2",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.13",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.43.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "author": {
    "name": "Simen"
  },
  "build": {
    "appId": "no.lysark.app",
    "productName": "Lysark",
    "copyright": "",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "resources/fonts/**",
      "package.json",
      "!node_modules/pdfjs-dist/**",
      "!node_modules/@napi-rs/**"
    ],
    "asar": true,
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education",
      "icon": "build/icon.png",
      "executableName": "lysark",
      "extraResources": [
        {
          "from": "vendor/ffmpeg/linux-x64",
          "to": "ffmpeg"
        },
        {
          "from": "build/licenses",
          "to": "licenses"
        }
      ],
      "synopsis": "PowerPoint til interaktiv HTML i USNs profil"
    },
    "win": {
      "target": [
        "zip"
      ],
      "icon": "build/icon.png",
      "signAndEditExecutable": false,
      "extraResources": [
        {
          "from": "vendor/ffmpeg/win32-x64",
          "to": "ffmpeg"
        },
        {
          "from": "build/licenses",
          "to": "licenses"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": [
        "nb_NO"
      ],
      "language": "1044",
      "shortcutName": "Lysark"
    }
  }
}
